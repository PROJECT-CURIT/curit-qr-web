# 비워 두면 Vite 개발 프록시와 동일 출처의 /api를 사용합니다.
VITE_API_BASE_URL=

# Supabase Edge Function JWT 검증에 사용하는 브라우저 공개용 anon 키입니다.
# service_role/secret 키를 넣으면 안 됩니다.
VITE_SUPABASE_ANON_KEY=

# 피그마 시연용 localStorage 주문 모드는 명시적으로 켠 경우에만 사용합니다.
VITE_PRESENTATION_MODE=false

# GitHub Pages처럼 하위 경로에 배포할 때만 사용합니다. 예: /curit-qr-web
VITE_BASE_PATH=
